# The part of Bundler the plugin uses: Bundler ships no signatures, nor does gem_rbs_collection.
module Bundler
  def self.unbundled_env: () -> Hash[String, String]
  def self.with_unbundled_env: [T] () { () -> T } -> T

  class BundlerError < StandardError
  end

  class PluginError < BundlerError
  end
end
