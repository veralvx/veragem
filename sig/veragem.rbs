module Veragem
  VERSION: String

  class Error < Bundler::PluginError
  end

  def self.run: (Array[String] argv, ?dir: String, ?input: Questions::_Input) -> String

  module Name
    PATTERN: Regexp
    PROBE: String

    self.@probed: Hash[[String, String, Array[String]], Array[String]]

    def self.modules: (String name) -> Array[String]
    def self.path: (String name) -> String
    def self.underscored: (String name) -> String
    def self.check: (String name) -> String
    def self.check_modules: (String name) -> void
    def self.probe: (String library, String path, Array[String] nestings) -> Array[String]
    private def self.answers: (String library, String path, Array[String] nestings) -> Array[String]
    private def self.check_shadowing: (String name, String shadowed, String found) -> void
    private def self.check_defined: (String name, Array[[String, String?]] defined, String? innermost) -> void
    private def self.library_of: (String name) -> String
    private def self.nestings_of: (String name) -> Array[String]
  end

  module Citation
    KEYS: Array[Symbol]
    ORCID: Regexp
    ORCID_BLOCKS: Array[Range[Integer]]

    def self.cited?: (Hash[Symbol, String | bool | nil] values) -> bool
    def self.check_values: (Hash[Symbol, String | bool | nil] values, bool citation) -> void
    def self.check_name: (String name, bool citation) -> void
    def self.check: (Symbol key, String value) { (String field, String text) -> String } -> String
    def self.default: (Symbol key, Hash[Symbol, String | bool | nil] values) -> String?
    def self.names: (String field, String names) -> String
    def self.keywords: (String value) { (String keyword) -> String } -> Array[String]
    def self.orcid: (String value) -> String
    private def self.valid?: (String digits) -> bool
  end

  class Project
    GITHUB: Regexp
    LICENSES: Hash[String, Array[String]]
    TAG: Regexp
    ANNOTATION: Regexp
    MAGIC: Regexp
    OPTIONAL: Hash[Symbol, String]

    attr_reader name: String
    attr_reader author: String
    attr_reader email: String?
    attr_reader github: String
    attr_reader summary: String
    attr_reader license: String
    attr_reader exe: bool
    attr_reader citation: bool
    attr_reader given_names: String?
    attr_reader family_names: String?
    attr_reader alias_name: String?
    attr_reader orcid: String?
    attr_reader keywords: Array[String]?

    def initialize: (String name, Hash[Symbol, untyped] values) -> void
    def path: () -> String
    def underscored: () -> String
    def constant: () -> String
    def modules: () -> Array[String]
    def licenses: () -> Array[String]
    def year: () -> Integer
    def today: () -> String
    def yaml: (String value) -> String
    def quote: (String value) -> String
    def nest: (String body, ?doc: String?) -> String
    def self.quote: (String value) -> String
    def self.check: (Symbol key, String value) -> String
    private def self.completed: (String value) -> String
    private def self.valid: [T < Object] (String field, T value) { (T) -> bool } -> T
    private def self.text: (String field, String value) -> String
    private def self.line: (String field, String value) -> String
    private def self.documented: (String summary) -> String
    private def self.annotation?: (String summary) -> bool

    private

    def extras: (Hash[Symbol, untyped] values) -> void
    def cite: (Hash[Symbol, untyped] values) -> void
    def indent: (String code) -> String
  end

  class Questions
    # what is read from: a line at a time, and whether a person types it
    interface _Input
      def gets: () -> String?
      def tty?: () -> bool
    end

    interface _Output
      def print: (String) -> void
      def puts: (?String) -> void
    end

    QUESTIONS: Hash[Symbol, String]

    @input: _Input
    @output: _Output
    @dir: String

    def self.none?: (String text) -> bool
    def initialize: (_Input input, _Output output, String dir) -> void
    def name: (String? given, exe: bool, citation: bool) -> String
    def values: (String name, Hash[Symbol, String | bool] given, Hash[Symbol, String] defaults)
              -> Hash[Symbol, String | bool | nil]

    private

    def check_name: (String name, bool exe, bool citation) -> String
    def answer: (Symbol key, String text, String name, Hash[Symbol, String | bool | nil] values) -> (String | bool)
    def default: (Symbol key, Hash[Symbol, String] defaults, Hash[Symbol, String | bool | nil] values) -> String?
    def ask: (String question, ?String? default, check: ^(String) -> (String | bool), ?optional: bool) -> (String | bool | nil)
    def offered: (String question, String? default, ^(String) -> (String | bool) check) -> String?
    def read: (String question, String? default, bool optional) -> String?
    def unanswered: (String question) -> nil
    def checked: (String question, String answer, ^(String) -> (String | bool) check, ?String note) -> (String | bool | nil)
    def terminal: [T] (String question) { () -> T } -> T
    def yes?: (String answer) -> bool
  end

  module Options
    GIT_CONFIG: Hash[Symbol, String]
    DEFAULTS: Hash[Symbol, String]
    BANNER: String
    OPTIONS: Array[[String, String]]

    def self.parse: (Array[String] argv, ?dir: String, ?config: ^(String) -> String?, ?input: Questions::_Input,
                     ?output: Questions::_Output) -> Project
    private def self.arguments: (Array[String] argv) -> [Array[String], Hash[Symbol, String | bool]]
    private def self.checked: (Symbol key, String value) -> String
    private def self.ask: (Array[String] names, Hash[Symbol, String | bool] given, Hash[Symbol, String] defaults,
                           Questions questions) -> Project
    private def self.name_of: (Array[String] names) -> String
    private def self.required: (Hash[Symbol, String] defaults, Hash[Symbol, String | bool] given) -> Hash[Symbol, String | bool]
    private def self.parser: () -> OptionParser
    private def self.git_config: (String key) -> String?
  end

  module Generator
    TEMPLATE: String
    EXE: Array[String]
    EXECUTABLES: Array[String]
    GIT_LOCAL: Hash[String, nil]
    LICENSE_FILES: Hash[String, String]
    CITATION: String
    TOOLS_LOCK: String

    def self.generate: (Project project, String target) -> void
    def self.check: (String name, exe: bool, citation: bool, target: String) -> String
    def self.check_name: (String name, bool exe) -> void
    private def self.check_target: (String target) -> void
    private def self.files: (Project project) -> Hash[String, String]
    private def self.templates: (bool exe) -> Array[String]
    private def self.tools: (?String lock) -> Array[String]
    private def self.path_of: (String file, String name) -> String
    private def self.removed_unless_done: (String target) { () -> void } -> void
    private def self.write: (String file, String destination, Project project) -> void
    private def self.stage: (String target, Array[String] executables) -> void
    private def self.render: (String source, Project project) -> String
    private def self.git: (String dir, *String args) -> void
  end
end
