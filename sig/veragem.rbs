module Veragem
  VERSION: String

  class Error < Bundler::PluginError
  end

  def self.run: (Array[String] argv, ?dir: String, ?input: Questions::_Input) -> String

  module Name
    PATTERN: Regexp
    PROBE: String

    def self.modules: (String name) -> Array[String]
    def self.check: (String name) -> String
    def self.check_modules: (String name) -> void
    def self.check_shadowing: (String name, String shadowed, String found) -> void
    def self.check_defined: (String name, Array[[String, String?]] defined, String? innermost) -> void
    def self.library_of: (String name) -> String
    def self.nestings_of: (String name) -> Array[String]
    def self.probe: (String library, String path, Array[String] nestings) -> Array[String]
  end

  class Project
    GITHUB: Regexp
    LICENSES: Hash[String, Array[String]]

    attr_reader name: String
    attr_reader author: String
    attr_reader email: String?
    attr_reader github: String
    attr_reader summary: String
    attr_reader license: String
    attr_reader exe: bool

    def initialize: (String name, Hash[Symbol, untyped] values) -> void
    def path: () -> String
    def underscored: () -> String
    def constant: () -> String
    def modules: () -> Array[String]
    def licenses: () -> Array[String]
    def year: () -> Integer
    def quote: (String value) -> String
    def nest: (String body, ?doc: String?) -> String
    def self.quote: (String value) -> String
    def self.github: (String value) -> String
    def self.license: (String value) -> String
    def self.text: (String field, String value) -> String

    private

    def self.valid: [T < Object] (String field, T value) { (T) -> bool } -> T
    def indent: (String code) -> String
  end

  class Questions
    # what is read from: a line at a time, and whether a person types it
    interface _Input
      def gets: () -> String?
      def tty?: () -> bool
    end

    interface _Output
      def print: (String) -> void
      def puts: (String) -> void
      def flush: () -> void
    end

    QUESTIONS: Hash[Symbol, String]

    @input: _Input
    @output: _Output
    @dir: String

    def initialize: (_Input input, _Output output, String dir) -> void
    def check: (Hash[Symbol, String | bool] given) -> void
    def name: (String? given, exe: bool) -> String
    def values: (String name, Hash[Symbol, String | bool] given, Hash[Symbol, String] defaults)
              -> Hash[Symbol, String | bool | nil]

    private

    def check_name: (String name, bool exe) -> String
    def checks: () -> Hash[Symbol, ^(String) -> String]
    def ask: (String question, ?String? default, check: ^(String) -> (String | bool), ?optional: bool) -> (String | bool | nil)
    def read: (String question, String? default) -> String?
    def checked: (String answer, ^(String) -> (String | bool) check) -> (String | bool | nil)
    def yes?: (String answer) -> bool
    def completed: (String answer) -> String
  end

  module Options
    GIT_CONFIG: Hash[Symbol, String]
    DEFAULTS: Hash[Symbol, String]
    BANNER: String

    def self.parse: (Array[String] argv, ?dir: String, ?config: ^(String) -> String?, ?input: Questions::_Input,
                     ?output: Questions::_Output) -> Project
    def self.ask: (Array[String] names, Hash[Symbol, String | bool] given, Hash[Symbol, String] defaults,
                   Questions questions) -> Project
    def self.name_of: (Array[String] names) -> String
    def self.required: (Hash[Symbol, String | bool | nil] values) -> Hash[Symbol, String | bool]
    def self.parser: () -> OptionParser
    def self.git_config: (String key) -> String?
  end

  module Generator
    TEMPLATE: String
    EXE: Array[String]
    GIT_LOCAL: Hash[String, nil]
    LICENSE_FILES: Hash[String, String]

    def self.files: (Project project) -> Hash[String, String]
    def self.skipped: (Project project) -> Array[String]
    def self.tools: () -> Array[String]
    def self.check: (Project project, Array[String] paths) -> void
    def self.check_tool: (String name) -> void
    def self.check_target: (String target) -> void
    def self.check_command: (String name, bool exe) -> void
    def self.path_of: (String file, Project project) -> String
    def self.generate: (Project project, String target) -> void
    def self.removed_unless_done: (String target) { () -> void } -> void
    def self.write: (String source, String destination, Project project) -> void
    def self.render: (String source, Project project) -> String
    def self.git: (String dir, *String args) -> void
  end
end
