module Veragem
  VERSION: String

  class Error < Bundler::PluginError
  end

  def self.run: (Array[String] argv, ?dir: String, ?input: Questions::_Input) -> String

  module Name
    PATTERN: Regexp
    RESERVED: Regexp
    LIBRARIES: Array[String]
    PROBE: String

    self.@probed: Hash[[String, String, Array[String]], Array[String]]

    def self.modules: (String name) -> Array[String]
    def self.path: (String name) -> String
    def self.underscored: (String name) -> String
    def self.check: (String name) -> String
    private def self.check_paths: (String name) -> void
    def self.check_modules: (String name) -> void
    def self.probe: (String library, String path, Array[String] nestings) -> Array[String]
    private def self.answers: (String library, String path, Array[String] nestings) -> Array[String]
    private def self.unchecked: (Array[String] nestings, String why) -> bot
    private def self.check_shadowing: (String name, String shadowed, String found) -> void
    private def self.check_defined: (String name, Array[[String, String?]] defined, String? innermost) -> void
    private def self.library_of: (String name) -> String
    private def self.nestings_of: (String name) -> Array[String]
  end

  module Citation
    KEYS: Array[Symbol]
    ORCID: Regexp
    ORCID_BLOCKS: Array[Range[Integer]]

    def self.cited?: (Hash[Symbol, String | bool | nil] values) -> bool
    def self.check_values: (Hash[Symbol, String | bool | nil] values, bool citation) -> void
    def self.check_name: (String name, bool citation) -> void
    def self.check: (Symbol key, String value) { (String field, String text) -> String } -> String
    def self.default: (Symbol key, Hash[Symbol, String | bool | nil] values) -> String?
    private def self.names: (String field, String names) -> String
    private def self.keywords: (String value) { (String keyword) -> String } -> Array[String]
    private def self.orcid: (String value) -> String
    private def self.valid?: (String digits) -> bool
  end

  module License
    SPDX: Hash[String, Array[String]]
    CHOICES: String

    def self.check: (String value) -> String
  end

  module Summary
    TAG: Regexp
    ANNOTATION: Regexp
    MAGIC: Regexp
    MARKDOWN: Regexp
    DASH: Regexp

    def self.check: (String summary) -> String
    private def self.refusal: (String summary) -> String?
    private def self.left_open?: (String summary) -> bool
    private def self.prose: (String summary) -> String
    private def self.annotation?: (String summary) -> bool
  end

  module Markdown
    MARKUP: Regexp

    def self.text: (String value) -> String
    def self.badge: (String label, String message, String color) -> String
  end

  class Project
    GITHUB: Regexp
    FIELDS: Hash[Symbol, String]
    OPTIONAL: Hash[Symbol, String]

    attr_reader name: String
    attr_reader author: String
    attr_reader email: String?
    attr_reader github: String
    attr_reader summary: String
    attr_reader license: String
    @exe: bool
    @citation: bool
    @badges: bool
    attr_reader given_names: String?
    attr_reader family_names: String?
    attr_reader alias_name: String?
    attr_reader orcid: String?
    attr_reader keywords: Array[String]?

    # each key's own type, which no Hash type has: Options' and Questions' hashes, asserted (#:)
    # one. Steep checks each field against the Hash's values.
    type values = { author: String, github: String, summary: String, license: String, ?exe: bool,
                    ?citation: bool, ?badges: bool, ?email: (String | false)?, ?given_names: (String | false)?,
                    ?family_names: String, ?alias: (String | false)?, ?orcid: String?, ?keywords: String? }

    def initialize: (String name, values values) -> void
    def exe?: () -> bool
    def citation?: () -> bool
    def badges?: () -> bool
    def path: () -> String
    def underscored: () -> String
    def constant: () -> String
    def modules: () -> Array[String]
    def licenses: () -> Array[String]
    def year: () -> Integer
    def today: () -> String
    def yaml: (String value) -> String
    def quote: (String value) -> String
    def markdown: (String value) -> String
    def badge: (String label, String message, String color) -> String
    def nest: (String body, ?doc: String?) -> String
    def self.field: (Symbol key) -> String
    def self.strip: (String text) -> String
    def self.quote: (String value) -> String
    def self.check: (Symbol key, String? value) -> String
    private def self.utf8: (Symbol key, String? value) -> String
    private def self.github: (String value) -> String
    private def self.text: (String field, String value) -> String
    private def self.line: (String field, String value) -> String

    private

    def extras: (values values) -> void
    def cite: (values values) -> void
    def optional: (Symbol key, (String | false)? value) -> String?
    def indent: (String code) -> String
  end

  class Questions
    # what is read from: a line at a time, and whether a person types it
    interface _Input
      def gets: () -> String?
      def tty?: () -> bool
    end

    interface _Output
      def print: (String) -> void
      def puts: (?String) -> void
    end

    QUESTIONS: Hash[Symbol, String]
    YES: Hash[String, bool]

    @input: _Input
    @output: _Output
    @dir: String
    @git: Hash[Symbol, String]

    def self.none?: (String text) -> bool
    def initialize: (_Input input, _Output output, String dir, ?git: Hash[Symbol, String]) -> void
    def name: (String? given, exe: bool, citation: bool) -> String
    def values: (String name, Hash[Symbol, String | bool] given, Hash[Symbol, String] defaults)
              -> Project::values

    private

    def check_name: (String name, bool exe, bool citation) -> String
    def answer: (Symbol key, String text, String name, Hash[Symbol, String | bool | nil] values) -> (String | bool)
    def default: (Symbol key, Hash[Symbol, String] defaults, Hash[Symbol, String | bool | nil] values) -> String?
    def source: (Symbol key) -> String
    def ask: (String question, ?String? default, check: ^(String) -> (String | bool), ?from: String, ?optional: bool)
           -> (String | bool | nil)
    def offered: (String question, String? default, String from, ^(String) -> (String | bool) check) -> String?
    def read: (String question, String? default, bool optional) -> String?
    def unanswered: (String question) -> nil
    def checked: (String question, String answer, ^(String) -> (String | bool) check, ?String note) -> (String | bool | nil)
    def terminal: [T] (String question) { () -> T } -> T
    def yes?: (String answer) -> bool
  end

  module Options
    GIT_CONFIG: Hash[Symbol, String]
    DEFAULTS: Hash[Symbol, String]
    BANNER: String
    OPTIONS: Array[[String, String]]

    def self.parse: (Array[String] argv, ?dir: String, ?config: ^(String) -> String?, ?input: Questions::_Input,
                     ?output: Questions::_Output) -> Project
    private def self.arguments: (Array[String] argv) -> [Array[String], Hash[Symbol, String | bool]]
    private def self.checked: (Symbol key, String value) -> String
    private def self.ask: (Array[String] names, Hash[Symbol, String | bool] given, Hash[Symbol, String] defaults,
                           Questions questions) -> Project
    private def self.name_of: (Array[String] names) -> String
    private def self.required: (Hash[Symbol, String] defaults, Hash[Symbol, String | bool] given) -> Project::values
    private def self.check_present: (Hash[Symbol, String | bool | nil] values) -> void
    private def self.parser: () -> OptionParser
    private def self.git_config: (String key) -> String?
  end

  module Generator
    TEMPLATE: String
    EXE: Array[String]
    EXECUTABLES: Array[String]
    OWN: Array[String]
    LICENSE_FILES: Hash[String, String]
    CITATION: String
    TOOLS_LOCK: String

    class Entry < Data
      attr_reader path: String
      attr_reader bytes: String
      attr_reader executable: bool
      attr_reader harness: bool

      def self.new: (String path, String bytes, bool executable, bool harness) -> instance
                  | (path: String, bytes: String, executable: bool, harness: bool) -> instance
    end

    def self.generate: (Project project, String target) -> void
    def self.entries: (Project project) -> Array[Entry]
    def self.check: (String name, exe: bool, citation: bool, target: String) -> String
    def self.check_name: (String name, bool exe) -> void
    def self.write: (String target, Entry entry) -> void
    private def self.check_target: (String target) -> void
    private def self.files: (Project project) -> Hash[String, String]
    private def self.templates: (bool exe) -> Array[String]
    private def self.tools: (?String lock) -> Array[String]
    private def self.path_of: (String file, String name) -> String
    private def self.removed_unless_done: (String target) { () -> void } -> void
    private def self.stage: (String target, Array[Entry] written, Project project) -> void
    private def self.render: (String source, Project project) -> String
  end

  class Record
    FILE: String
    SOURCES: Array[String]
    ID: Regexp
    PART: Regexp

    attr_reader version: String
    attr_reader source: String
    attr_reader name: String
    attr_reader values: Hash[Symbol, String | bool | nil]
    attr_reader files: Hash[String, String]

    def self.source_of: (String root) -> String
    def self.values_of: (Project project) -> Hash[Symbol, String | bool | nil]
    def self.of: (Project project, String target, Array[Generator::Entry] entries) -> Record
    def self.read: (String dir) -> Record
    def initialize: (version: String, source: String, name: String, values: Hash[Symbol, String | bool | nil],
                     files: Hash[String, String]) -> void
    def project: () -> Project
    def write: (String dir) -> void
    private def self.valid?: (Hash[Symbol, untyped] files) -> bool
    private def self.parse: (untyped data) -> Record
  end

  module Git
    LOCAL: Hash[String, nil]

    def self.run: (String dir, *String args) -> void
    def self.output: (String dir, *String args, ?input: String?) -> String
    def self.ids: (String dir, Array[String] paths) -> Hash[String, String]
    def self.id: (String dir, String path, String bytes) -> String
    def self.object?: (String dir, String id) -> bool
    def self.executable: (String dir, Array[String] paths) -> void
    def self.merge: (String dir, String ours, String base, String theirs) -> [String, Integer]
    private def self.written: (String path, String bytes) -> String
    private def self.capture: (String dir, Array[String] args, String? input) -> [String, Process::Status]
  end

  module Sync
    BANNER: String
    OPTIONS: Array[[String, String]]

    type options = Hash[Symbol, String | bool]

    def self.main: (Array[String] argv, ?dir: String, ?input: Questions::_Input, ?output: Questions::_Output) -> void
    def self.options: (Array[String] argv) -> [options, Array[String]?]
    def self.render: (Record record, String dir) -> void
    def self.source: () -> String
    private def self.adopted: (Array[String] argv, String dir) -> Record
    private def self.check: (Record record, bool force) -> void
    private def self.parser: () -> OptionParser

    module Plan
      APPLIED: Array[Symbol]

      class Row < Data
        attr_reader path: String
        attr_reader action: Symbol
        attr_reader base: String?
        attr_reader ours: String?
        attr_reader theirs: String?

        def self.new: (String path, Symbol action, String? base, String? ours, String? theirs) -> instance
                    | (path: String, action: Symbol, base: String?, ours: String?, theirs: String?) -> instance
      end

      def self.action: (String? base, String? ours, String? theirs) -> Symbol
      def self.rows: (Hash[String, String] base, Hash[String, String] ours, Hash[String, String] theirs) -> Array[Row]
      def self.recorded: (Array[Row] rows, Array[Row] applied) -> Hash[String, String]
      private def self.changed: (String base, String? ours, String? theirs) -> Symbol
    end

    module Selection
      PROMPT: String

      def self.ask: (Questions::_Input input, Questions::_Output output, Integer count, Array[Integer] defaults) -> Array[Integer]
      def self.parse: (String answer, Integer count, Array[Integer] defaults) -> Array[Integer]?
      private def self.numbers: (String list, Integer count) -> Array[Integer]?
    end

    class Run
      MEANINGS: Hash[Symbol, String]

      @dir: String
      @record: Record
      @options: options
      @input: Questions::_Input
      @output: Questions::_Output

      def initialize: (String dir, Record record, options options, input: Questions::_Input, output: Questions::_Output) -> void
      def call: () -> void

      private

      def harness: () -> [Hash[String, Generator::Entry], Array[String]]
      def rows: (Hash[String, Generator::Entry] entries, Array[String] own) -> Array[Plan::Row]
      def check_clean: (Array[String] paths) -> void
      def ours: (Array[String] paths) -> Hash[String, String]
      def choose: (Array[Plan::Row] shown) -> Array[Plan::Row]
      def ask: (Array[Plan::Row] shown, Array[Plan::Row] taken) -> Array[Plan::Row]
      def line: (Plan::Row row, ?Symbol why) -> String
      def apply: (Plan::Row row, Generator::Entry? entry, Hash[Plan::Row, String?] bases) -> Symbol
      def merge: (Plan::Row row, Generator::Entry entry, String? base) -> Symbol
      def bases: (Array[Plan::Row] merges) -> Hash[Plan::Row, String?]
      def lost: (Hash[Plan::Row, String?] bases) -> void
      def rebuild: () -> void
      def finish: (Array[Plan::Row] rows, Array[Plan::Row] chosen, Hash[String, Generator::Entry] entries) -> void
      def applied: (Array[Plan::Row] chosen, Hash[String, Generator::Entry] entries) -> Hash[Plan::Row, Symbol]
      def record: (Hash[String, String] files) -> void
    end

    module Source
      SCRIPT: String

      def self.launch: (Array[String] argv, ?dir: String) -> void
      def self.harness: (String version, String dir) -> Hash[String, String]
      private def self.path_of: (Array[String] argv) -> String?
      private def self.fetch: (String? version, String dir) -> String
      private def self.gem_command: (Array[String] args, String dir) -> bool?
      private def self.sync?: (String root) -> bool
      private def self.run: (String root, Array[String] argv, String dir) -> bool?
    end
  end
end
