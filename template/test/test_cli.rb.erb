# frozen_string_literal: true

require "test_helper"
require "<%= path %>/cli"

class Test<%= constant.delete(":") %>CLI < Minitest::Test
  COMMAND_LINE = <%= constant %>::CLI

  def test_it_greets_the_name_given
    assert_output("Hello, Ada!\n") { assert_equal 0, COMMAND_LINE.run(["Ada"]) }
  end

  def test_nobody_named_it_greets_the_world
    assert_output("Hello, world!\n") { assert_equal 0, COMMAND_LINE.run([]) }
  end

  def test_it_prints_its_version
    expected = "<%= name %> #{<%= constant %>::VERSION}\n"
    assert_output(expected) { assert_equal 0, command("--version") }
  end

  def test_it_prints_its_help
    help = <<~HELP
      Usage: <%= name %> [options] [NAME]
          -h, --help                       Print this help
              --version                    Print the version
    HELP
    %w[-h --help].each { |option| assert_output(help) { assert_equal 0, command(option) } }
  end

  def test_an_unknown_option_is_refused
    assert_output("", /\A<%= name %>: invalid option: --nope\nUsage: /) do
      assert_equal 2, COMMAND_LINE.run(["--nope"])
    end
  end

  def test_more_than_one_name_is_refused
    assert_output("", /\A<%= name %>: needless argument: Bob\n/) do
      assert_equal 2, COMMAND_LINE.run(%w[Ada Bob])
    end
  end

  def test_the_executable_runs_it_and_exits_with_its_status
    assert_equal ["Hello, Ada!\n", 0], executable("Ada")
    assert_equal 2, executable("--nope").last
  end

  private

  # exe/<%= name %>'s output, and its exit status
  def executable(*argv)
    exe = File.expand_path("../exe/<%= name %>", __dir__)
    lib = File.expand_path("../lib", __dir__)
    out, = capture_subprocess_io { system(RbConfig.ruby, "-I", lib, exe, *argv) }
    [out, Process.last_status.exitstatus]
  end

  # OptionParser's own --help and --version print as these do, then exit the process: the command
  # returns its status instead
  def command(option)
    COMMAND_LINE.run([option])
  rescue SystemExit
    flunk "#{option} exited the process"
  end
end
