# frozen_string_literal: true

require "test_helper"
require "<%= path %>/cli"

class TestCLI < Minitest::Test
  def test_it_greets_the_name_given
    assert_output("Hello, Ada!\n") { assert_equal 0, <%= constant %>::CLI.run(["Ada"]) }
  end

  def test_nobody_named_it_greets_the_world
    assert_output("Hello, world!\n") { assert_equal 0, <%= constant %>::CLI.run([]) }
  end

  def test_version
    expected = "<%= name %> #{<%= constant %>::VERSION}\n"
    assert_output(expected) { assert_equal 0, <%= constant %>::CLI.run(["--version"]) }
  end

  def test_an_unknown_option_is_refused
    assert_output("", /invalid option: --nope/) { assert_equal 2, <%= constant %>::CLI.run(["--nope"]) }
  end

  def test_the_executable_runs_it
    executable = File.expand_path("../exe/<%= name %>", __dir__)
    out, = capture_subprocess_io { system(RbConfig.ruby, executable, "Ada", exception: true) }

    assert_equal "Hello, Ada!\n", out
  end
end
