# frozen_string_literal: true

require "test_helper"
require "<%= path %>/cli"

class Test<%= constant.delete(":") %>CLI < Minitest::Test
  COMMAND = <%= constant %>::CLI

  def test_it_greets_the_name_given
    assert_output("Hello, Ada!\n") { assert_equal 0, COMMAND.run(["Ada"]) }
  end

  def test_nobody_named_it_greets_the_world
    assert_output("Hello, world!\n") { assert_equal 0, COMMAND.run([]) }
  end

  def test_version
    expected = "<%= name %> #{<%= constant %>::VERSION}\n"
    assert_output(expected) { assert_equal 0, COMMAND.run(["--version"]) }
  end

  def test_help
    usage = /\AUsage: <%= name %> \[options\] \[NAME\]\n/

    assert_output(usage) { assert_equal 0, COMMAND.run(["--help"]) }
  end

  def test_an_unknown_option_is_refused
    assert_output("", /invalid option: --nope/) { assert_equal 2, COMMAND.run(["--nope"]) }
  end

  def test_the_executable_runs_it
    executable = File.expand_path("../exe/<%= name %>", __dir__)
    lib = File.expand_path("../lib", __dir__)
    out, = capture_subprocess_io { system(RbConfig.ruby, "-I", lib, executable, "Ada", exception: true) }

    assert_equal "Hello, Ada!\n", out
  end
end
