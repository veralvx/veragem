# frozen_string_literal: true

require "test_helper"

class Test<%= constant.delete(":") %> < Minitest::Test
  def test_the_version_is_major_minor_patch
    assert_match(/\A\d+\.\d+\.\d+\z/, <%= constant %>::VERSION)
  end

  def test_it_greets_the_name_given
    assert_equal "Hello, Ada!", <%= constant %>.greeting("Ada")
  end

  def test_nobody_named_it_greets_the_world
    assert_equal "Hello, world!", <%= constant %>.greeting(" \n")
  end

  # A property, checked on many generated names and whitespace around them (pbt).
  def test_surrounding_whitespace_changes_nothing
    gem = <%= constant %>
    whitespace = Pbt.array(Pbt.one_of(*" \t\n\v\f\r".chars))
    Pbt.assert do
      Pbt.property(Pbt.printable_string, whitespace, whitespace) do |name, before, after|
        assert_equal gem.greeting(name), gem.greeting("#{before.join}#{name}#{after.join}")
      end
    end
  end
end
