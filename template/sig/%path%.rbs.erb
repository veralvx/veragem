<%# `::`: a module of the gem's could be named String, or Hash -%>
<%= nest(<<~RBS + (exe ? <<~CLI : ""))
  VERSION: ::String

  def self.greeting: (::String name) -> ::String
RBS

  module CLI
    def self.run: (::Array[::String] argv) -> ::Integer

    private def self.output: (::Hash[::Symbol, bool] options, ::String name) -> (::OptionParser | ::String)?

    private def self.parser: () -> ::OptionParser
  end
CLI
-%>
