# frozen_string_literal: true

require "optparse"
require_relative "../<%= File.basename(path) %>"

<%# `::` where one of the gem's modules is named OptionParser, which its lookup would find first -%>
<%- option_parser = "#{"::" if modules.include?("OptionParser")}OptionParser" -%>
<%= nest(<<~RUBY)
  # The command line: `#{name} [NAME]` prints the greeting.
  module CLI
    # Runs the command line with +argv+.
    # @param argv [Array<String>] the command's arguments
    # @return [Integer] the exit status: 0, or 2 for an option refused, or more than one name
    def self.run(argv)
      options = { help: false, version: false }
      name, *others = parser.parse(argv, into: options)
      raise #{option_parser}::NeedlessArgument.new(*others) unless others.empty?

      puts output(options, name.to_s)
      0
    rescue #{option_parser}::ParseError => e
      warn e, parser
      2
    end

    private_class_method def self.output(options, name)
      if options[:help]
        parser
      elsif options[:version]
        parser.ver
      else
        #{modules.last}.greeting(name)
      end
    end

    # --help as an option of its own: OptionParser's built-in one exits the process.
    private_class_method def self.parser
      #{option_parser}.new("Usage: #{name} [options] [NAME]") do |opts|
        opts.program_name = "#{name}"
        opts.version = VERSION
        opts.on("-h", "--help", "Print this help")
        opts.on("--version", "Print the version")
      end
    end
  end
RUBY
-%>
