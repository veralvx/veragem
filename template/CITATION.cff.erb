# The citation GitHub's "Cite this repository" and Zenodo read (Citation File Format 1.2.0);
# `rake bump` sets version and date-released at each release.
cff-version: 1.2.0
message: "If you use this software, please cite it using the metadata from this file."
title: <%= yaml(name) %>
abstract: <%= yaml(summary) %>
authors:
  - family-names: <%= yaml(family_names) %>
<%- if given_names -%>
    given-names: <%= yaml(given_names) %>
<%- end -%>
<%- if alias_name -%>
    alias: <%= yaml(alias_name) %>
<%- end -%>
<%- if orcid -%>
    orcid: "<%= orcid %>"
<%- end -%>
<%- if keywords -%>
keywords:
<%- keywords.each do |keyword| -%>
  - <%= yaml(keyword) %>
<%- end -%>
<%- end -%>
version: "0.1.0"
date-released: "<%= today %>"
<%- if licenses.one? -%>
license: <%= licenses.first %>
<%- else -%>
# MIT OR Apache-2.0, as CFF writes an OR; Zenodo's import refuses a list, so it archives no release
# until zenodo/zenodo-rdm#1509 is fixed
license:
<%- licenses.each do |spdx| -%>
  - <%= spdx %>
<%- end -%>
<%- end -%>
repository-code: "https://github.com/<%= github %>/<%= name %>"
repository-artifact: "https://rubygems.org/gems/<%= name %>"
# the API documentation rubydoc.info serves for each gem on RubyGems: there from the first release
url: "https://rubydoc.info/gems/<%= name %>"
# Zenodo's DOIs, to uncomment once it has archived a release: the concept DOI, every version's
# (Zenodo's "Cite all versions"), and a version's own -- minted after its release is tagged, so the
# file can hold an earlier version's alone
# doi: "10.5281/zenodo.0000000"
# identifiers:
#   - type: doi
#     value: "10.5281/zenodo.0000000"
#     description: "The concept DOI, of every version"
#   - type: doi
#     value: "10.5281/zenodo.0000001"
#     description: "The DOI of version 0.1.0"
